# Backend env — copy to backend/.env and adjust.
# Validated on startup by src/config/env.ts (zod). DATABASE_URL is required.

# Local (backend run via `npm run dev`, Postgres from `docker compose up -d db`):
DATABASE_URL=postgresql://teamnap:teamnap_dev@localhost:5432/teamnap
# Inside Docker Compose the DB host is `db`:
# DATABASE_URL=postgresql://teamnap:teamnap_dev@db:5432/teamnap

PORT=3000
HOST=0.0.0.0

# Caller identity for routes NOT behind `authenticate` that also omit the
# X-User-Id header. Matches the dev user created by `npm run db:seed`.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Lifetime of an issued session token, in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Lifetime of a password-reset token, in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# AI comment generation (Ollama). Defaults live in src/config/env.ts.
# gemma3n:e2b needs ~8GB/2CPU. On a smaller box use `gemma3:1b` (weaker JP)
# or leave Ollama off entirely (everything falls back to rule-based copy).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3n:e2b
# Per-generation timeout (ms). On timeout → rule-based / canned copy.
# Gemma nap-advice generation can take ~24s, so keep this generous.
OLLAMA_TIMEOUT_MS=30000

# API-flow debug tracer (src/lib/api-flow.ts). Off by default.
# DEBUG_API_FLOW=1
# DEBUG_API_FLOW_SCOPE=/teams
