# Backend env — copy to backend/.env and adjust.
# Validated on startup by src/config/env.ts (zod). DATABASE_URL is required.

# Local (backend run via `npm run dev`, Postgres from `docker compose up -d db`):
DATABASE_URL=postgresql://teamnap:teamnap_dev@localhost:5432/teamnap
# Inside Docker Compose the DB host is `db`:
# DATABASE_URL=postgresql://teamnap:teamnap_dev@db:5432/teamnap

PORT=3000
HOST=0.0.0.0

# Caller identity for routes NOT behind `authenticate` that also omit the
# X-User-Id header. Matches the dev user created by `npm run db:seed`.
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Lifetime of an issued session token, in hours (default 720 = 30 days).
SESSION_TTL_HOURS=720

# Lifetime of a password-reset token, in minutes (default 60).
PASSWORD_RESET_TTL_MINUTES=60

# AI comment generation (Ollama). Defaults live in src/config/env.ts.
# gemma4:e2b (~7.2GB) is the default — best Japanese, needs ~8GB/2CPU and
# ~24s warm. On a smaller box set gemma3:1b (~815MB, fits 4GB/1CPU).
# Ollama can also be left off — everything falls back to the rule-based
# / canned copy.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
# Per-generation timeout (ms). On timeout → rule-based / canned copy.
OLLAMA_TIMEOUT_MS=60000

# Expo push. The URL is stable. EXPO_ACCESS_TOKEN is optional — set it
# (expo.dev → Account → Access tokens) only if "Enhanced Security for
# Push Notifications" is on for the project; unauthenticated sends work
# without it. Leave both unset for local dev.
# EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# EXPO_ACCESS_TOKEN=

# API-flow debug tracer (src/lib/api-flow.ts). Off by default.
# DEBUG_API_FLOW=1
# DEBUG_API_FLOW_SCOPE=/teams

# --- Google OAuth + Calendar (all optional) --------------------------------
# Leave unset → "Sign in with Google" is rejected with a clear message and
# calendar "sync" keeps importing the sample week. Set CLIENT_ID +
# TOKEN_ENC_KEY (minimum) to turn it on. Full setup: docs/google-integration.md.
#
# Web OAuth client (has a secret — server only). Also the id_token audience.
# GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxx
# Native clients (public, no secret). Needed for the iOS / Android apps.
# GOOGLE_OAUTH_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
# Redirect URIs the app may present (comma / space separated). Empty = allow
# teamnap:// + localhost + auth.expo.io.
# GOOGLE_OAUTH_REDIRECT_URIS=teamnap://oauthredirect,http://localhost:8081
# 32-byte AES key (base64 or hex) for encrypting stored Google tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# GOOGLE_TOKEN_ENC_KEY=
# Scopes (default shown). calendar.events.readonly is the minimum useful set.
# GOOGLE_OAUTH_SCOPES=openid email profile https://www.googleapis.com/auth/calendar.events.readonly
# Public https origin of THIS API — enables the events.watch push webhook.
# GOOGLE_WEBHOOK_TOKEN must also be set for the webhook to be trusted.
# PUBLIC_BASE_URL=https://api.example.com
# GOOGLE_WEBHOOK_TOKEN=some-long-random-string
# Background incremental-sync cadence in minutes (0 disables the job).
# GOOGLE_CALENDAR_SYNC_MINUTES=15
