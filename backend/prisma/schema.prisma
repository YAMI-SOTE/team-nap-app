// Team Nap — Prisma schema.
// Prisma 7: the connection URL lives in prisma.config.ts (DATABASE_URL),
// not here. The runtime client uses the `@prisma/adapter-pg` driver
// adapter (see src/lib/prisma.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String?
  // Chosen avatar id ("cat" | "man" | "woman" — a placeholder set, see
  // mobile/src/constants/avatars.ts). Null → initials fallback.
  avatar              String?
  // scrypt hash ("scrypt$<saltHex>$<hashHex>"). Null for users created by
  // the seed / legacy `ensureUser` path or a future OAuth-only sign-in.
  passwordHash        String?
  /// Google `sub` (stable account id). Set when the user signs in with
  /// Google or links it from settings. Unique, nullable — password-only
  /// users have none. Kept even if the calendar is later disconnected, so
  /// "Sign in with Google" keeps working independently of `GoogleAccount`.
  googleId            String?              @unique
  createdAt           DateTime             @default(now())
  memberships         TeamMembership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  onboarding          Onboarding?
  naps                NapRecord[]
  calendarEvents      CalendarEvent[]
  notifications       Notification[]
  napSession          NapSession?
  pushTokens          PushToken[]
  googleAccount       GoogleAccount?
}

/// OAuth tokens + Calendar sync state for a user who connected their
/// Google account. Split from `User` so "disconnect calendar" drops just
/// this row while the account (and Google login) survive. `*TokenEnc`
/// columns are AES-256-GCM blobs (src/lib/secret-box.ts) — the raw
/// access / refresh tokens never touch the database.
model GoogleAccount {
  userId               String    @id
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  googleId             String    @unique
  email                String
  /// Space-separated scopes actually granted.
  scope                String    @default("")
  accessTokenEnc       String
  accessTokenExpiresAt DateTime
  /// Null when Google did not re-issue one (consent skipped) — the
  /// previously stored value is kept in that case.
  refreshTokenEnc      String?
  calendarIds          String[]  @default(["primary"])
  /// Calendar incremental-sync token; null forces a full resync.
  syncToken            String?
  /// events.watch push channel. Null when not watching / webhooks off.
  watchChannelId       String?   @unique
  watchResourceId      String?
  watchExpiresAt       DateTime?
  connectedAt          DateTime  @default(now())
  lastSyncedAt         DateTime?
  updatedAt            DateTime  @updatedAt
}

/// An Expo push token for one of the user's devices. Registered from the
/// app after sign-in (`POST /notifications/token`) and used to deliver
/// every `addNotification` as a push (`src/services/push.service.ts`).
/// The token is globally unique; if it re-registers under a different
/// user (device handed over) the row is reassigned. Tokens that Expo
/// reports as `DeviceNotRegistered` are pruned on the next send.
model PushToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A nap the user has started but not yet finished — backs the
/// "仮眠の状況 / あと◯分" card on a teammate's detail screen. At most one
/// per user (`userId @unique`): starting the Rest timer upserts a row,
/// finishing / cancelling / recording the nap deletes it. A row left
/// dangling (app killed mid-nap) is treated as ended once `wakeAt` is
/// more than 30 min in the past (src/services/nap-session.service.ts).
model NapSession {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  startedAt DateTime @default(now())
  /// Planned wake time = startedAt + the timer's minutes.
  wakeAt    DateTime
  createdAt DateTime @default(now())
}

/// One entry in a user's notification feed (the お知らせ screen). Persisted
/// so the feed survives a restart. Written by `nudge.service` (to the
/// recipient) and `team.service` (to existing members on join / removal /
/// nap suggestion); read + marked-read via /notifications.
/// `createdAt` is authoritative — the relative "2分前" label and the
/// today / earlier grouping are derived at read time
/// (src/services/notifications.service.ts).
model Notification {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// NotificationKind union, stored as text: "welcome" | "team_nap_suggestion"
  /// | "wake_request" | "rest_request" | "nap_ended" | "weekly_review"
  /// | "member_joined".
  kind      String
  title     String
  body      String
  /// Null = unread. Set when the user marks it read.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// One entry in a user's schedule. Backs the スケジュール screen CRUD and
/// feeds the free-time / nap-timing logic (src/services/schedule.service.ts).
/// `source` distinguishes hand-added events ("manual") from ones pulled in
/// by the Google Calendar sync ("google"); the latter carry a stable
/// `externalId` and are replaced wholesale on every re-sync.
model CalendarEvent {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String   @default("")
  date       String // "YYYY-MM-DD" (local calendar day)
  start      String // "HH:MM"
  end        String // "HH:MM"
  allDay     Boolean  @default(false)
  source     String   @default("manual") // "manual" | "google"
  externalId String? // id from the source system; null for manual events
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, externalId])
  @@index([userId, date])
}

/// A recorded nap. A user may record several on the same calendar date.
/// `aiAdvice` holds the suggestion generated at record time (see
/// src/services/nap-advice.service.ts), shown on the ふりかえり screen and
/// reachable later from the history list.
model NapRecord {
  id           String   @id @default(uuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         String // "YYYY-MM-DD"
  start        String // "HH:MM"
  end          String // "HH:MM"
  minutes      Int
  wakeStars    Int      @default(0)
  focusDeltaPt Int      @default(0)
  aiAdvice     String?
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

/// One row per user, holding the answers collected during onboarding.
/// Created with defaults at sign-up (and lazily for legacy users), so a
/// missing/incomplete row means "still needs to go through onboarding".
/// `completedAt` is set once the user finishes the questions.
/// Also backs the Settings screens (sleep schedule, notification toggles,
/// calendar links) so they share one per-user row with onboarding rather
/// than a global in-memory copy.
model Onboarding {
  userId                  String    @id
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bedtime                 String    @default("23:30")
  wakeTime                String    @default("07:30")
  napCutoffHour           Int       @default(15)
  calendarConnected       Boolean   @default(false)
  calendarDeviceConnected Boolean   @default(false)
  // When the Google Calendar events were last pulled in. Null = never / disconnected.
  calendarLastSyncedAt    DateTime?
  notificationsEnabled    Boolean   @default(false)
  notifyNapSuggestion     Boolean   @default(true)
  notifyNapEnd            Boolean   @default(true)
  notifyTeamNapSuggestion Boolean   @default(true)
  notifyWakeSupport       Boolean   @default(true)
  completedAt             DateTime?
  updatedAt               DateTime  @updatedAt
}

/// Single-use, short-lived token for the "forgot password" flow. Like
/// `Session`, only the SHA-256 hash of the emailed token is stored.
/// See src/services/password-reset.service.ts.
model PasswordResetToken {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// An issued bearer token. The raw token is returned to the client once;
/// only its SHA-256 hash is stored. Sessions expire (`expiresAt`) and can
/// be revoked (`revokedAt`) — see src/services/session.service.ts.
model Session {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model Team {
  id                   String           @id @default(uuid())
  name                 String
  inviteCode           String           @unique
  /// inviteCode with case + separators stripped (normalizeCode), for an
  /// indexed lookup on join instead of scanning every team.
  inviteCodeNormalized String           @unique @default("")
  createdAt            DateTime         @default(now())
  members              TeamMembership[]
}

enum MemberActivity {
  online
  resting
}

model TeamMembership {
  id                String         @id @default(uuid())
  team              Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  activity          MemberActivity @default(online)
  wakeAssistEnabled Boolean        @default(true)
  /// "owner" (the creator) or "member". Only an owner can remove members.
  role              String         @default("member")
  joinedAt          DateTime       @default(now())
  /// Last authenticated request / WS pong from this member. Bumped at most
  /// once every ~90s (touchLastSeen). Older than OFFLINE_AFTER → the
  /// roster shows them "offline" regardless of `activity`.
  lastSeenAt        DateTime       @default(now())

  // A user belongs to at most one team; enforced additionally in the service.
  @@unique([teamId, userId])
  @@unique([userId])
}
