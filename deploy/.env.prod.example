# Public VPS deployment — copy to the REPO ROOT as `.env` (not backend/.env).
# Docker Compose auto-reads the repo-root .env for ${VAR} expansion.
#
#   cp deploy/.env.prod.example .env
#   # then edit the values below

# The hostname judges' browsers will hit. An A record for it must point at
# this VPS's public IP. Caddy gets a Let's Encrypt cert for exactly this name.
# No-domain option: use <VPS_PUBLIC_IP>.sslip.io  (e.g. 203.0.113.10.sslip.io)
API_DOMAIN=api.example.com

# Disables dev-only helpers (GET /auth/debug, reset token in responses).
NODE_ENV=production

# 8GB VPS: keep this small. gemma4:e2b (~7GB) will OOM. Or omit Ollama entirely.
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_MS=60000

# Strongly recommended: change the DB password from the compose default.
# If set, also update DATABASE_URL in compose.yaml (backend service) to match,
# or override it here and reference ${POSTGRES_PASSWORD} there.
# POSTGRES_PASSWORD=change-me-to-something-long
