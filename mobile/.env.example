# Local dev (Expo Go / simulator / web). Copy to mobile/.env.
# See docs/setup.md for the per-environment values (simulator vs. LAN IP).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# For EAS builds (preview / production) this is NOT read from .env — set it
# per environment on EAS instead, pointing at a publicly reachable HTTPS API:
#
#   eas env:set --environment preview \
#     --name EXPO_PUBLIC_API_URL --value https://<your-api-host>/api/v1
#
# See docs/device-testing.md "EAS preview ビルド".

# --- Google Sign-In (optional) -------------------------------------------
# Public OAuth client ids, one per platform (no secret — that lives on the
# backend). Unset → the "Sign in with Google" buttons stay disabled.
# Setup: docs/google-integration.md.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxx.apps.googleusercontent.com
