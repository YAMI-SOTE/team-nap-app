# Only fail `npm audit` (and scripted installs that chain on it) for high /
# critical advisories. The 3 remaining "moderate" reports come from
# decode-uri-component -> query-string -> expo-router, which Expo SDK 57
# pins to query-string@7 (CommonJS). The only patched decode-uri-component
# (0.5.0) is ESM-only and breaks query-string@7's require(), so it cannot
# be overridden without breaking expo-router's URL routing. It clears when
# Expo bumps query-string upstream. See docs/dependency-security.md.
audit-level=high
